<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Version>1.0.1</Version>
    <Platforms>x64</Platforms>
    <Deterministic>true</Deterministic>
    <NuGetAudit>true</NuGetAudit>
  </PropertyGroup>
</Project>
